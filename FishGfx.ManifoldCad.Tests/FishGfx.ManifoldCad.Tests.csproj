<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CadNativeRuntimeDir>$(MSBuildThisFileDirectory)..\FishGfx.CadKernel.Native\out\build\windows-x64\$(Configuration)</CadNativeRuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <ProjectReference Include="..\FishGfx.CadKernel\FishGfx.CadKernel.csproj" />
    <ProjectReference Include="..\FishGfx.Im3d\FishGfx.Im3d.csproj" />
    <ProjectReference Include="..\FishGfx.ManifoldCad\FishGfx.ManifoldCad.csproj" />
    <None Include="..\corsa_flange.step"
          Link="TestData\corsa_flange.step"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyCadNativeRuntimeForTests" AfterTargets="Build">
    <ItemGroup Condition="Exists('$(CadNativeRuntimeDir)')">
      <CadNativeTestRuntime Include="$(CadNativeRuntimeDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CadNativeTestRuntime)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(CadNativeTestRuntime)' != ''" />
  </Target>
</Project>
