<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseSystemDrawing>true</UseSystemDrawing>
    <NoWarn>$(NoWarn);CA1416;CS0612</NoWarn>
    <CadNativeBuildRoot>$(MSBuildThisFileDirectory)..\FishGfx.CadKernel.Native\out\build\windows-x64</CadNativeBuildRoot>
    <CadNativeRuntimeDir>$(CadNativeBuildRoot)\$(Configuration)</CadNativeRuntimeDir>
    <CadOcctNotice>$(CadNativeBuildRoot)\vcpkg_installed\x64-windows\share\opencascade\copyright</CadOcctNotice>
    <CadBundledCMakeFromBin>$(MSBuildToolsPath)\..\..\..\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CadBundledCMakeFromBin>
    <CadBundledCMakeFromAmd64>$(MSBuildToolsPath)\..\..\..\..\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CadBundledCMakeFromAmd64>
    <CadCMakeExecutable Condition="Exists('$(CadBundledCMakeFromBin)')">$(CadBundledCMakeFromBin)</CadCMakeExecutable>
    <CadCMakeExecutable Condition="'$(CadCMakeExecutable)' == '' and Exists('$(CadBundledCMakeFromAmd64)')">$(CadBundledCMakeFromAmd64)</CadCMakeExecutable>
    <CadCMakeExecutable Condition="'$(CadCMakeExecutable)' == '' and Exists('$(VSINSTALLDIR)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">$(VSINSTALLDIR)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CadCMakeExecutable>
    <CadCMakeExecutable Condition="'$(CadCMakeExecutable)' == ''">cmake</CadCMakeExecutable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FishGfx\FishGfx.csproj" />
    <ProjectReference Include="..\FishGfx.FishUI\FishGfx.FishUI.csproj" />
    <ProjectReference Include="..\FishGfx.CadKernel\FishGfx.CadKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\thirdparty\FishUI\FishUI\data\**\*"
             Link="data\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="EnsureCadNativeRuntimeConfigured"
          BeforeTargets="BuildCadNativeRuntime"
          Condition="!Exists('$(CadNativeBuildRoot)\CMakeCache.txt')">
    <Error Text="The native CAD runtime is not configured. Run .\tools\bootstrap-manifold-cad.ps1 -Configuration $(Configuration) from a Visual Studio developer environment." />
  </Target>
  <Target Name="BuildCadNativeRuntime"
          BeforeTargets="CopyCadNativeRuntime"
          Condition="Exists('$(CadNativeBuildRoot)\CMakeCache.txt')">
    <Exec Command="&quot;$(CadCMakeExecutable)&quot; --build &quot;$(CadNativeBuildRoot)&quot; --config $(Configuration)" />
  </Target>
  <Target Name="CopyCadNativeRuntime" AfterTargets="Build">
    <ItemGroup Condition="Exists('$(CadNativeRuntimeDir)')">
      <CadNativeRuntime Include="$(CadNativeRuntimeDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CadNativeRuntime)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(CadNativeRuntime)' != ''" />
    <MakeDir Directories="$(OutDir)notices" Condition="Exists('$(CadOcctNotice)')" />
    <Copy SourceFiles="$(CadOcctNotice)"
          DestinationFiles="$(OutDir)notices\OpenCASCADE-LICENSE.txt"
          SkipUnchangedFiles="true"
          Condition="Exists('$(CadOcctNotice)')" />
  </Target>
</Project>
